+function isItem(value: unknown): value is PlanItemLike {
+  return typeof value === 'object' && value !== null
+}
+
+/**
+ * Every node of the plan in display order, flattened depth-first.
+ *
+ * The row key is a tool NAME, and both todo tools register `todo_write`, so the
+ * row summarizes whichever one a deployment mounted. Counting only the top level
+ * would drop nested completions and miss an `in_progress` child, reporting a
+ * count that disagrees with the tree the model wrote.
+ *
+ * The walk uses an explicit stack rather than recursion because the args are
+ * unvalidated: `JSON.parse` accepts nesting far deeper than the call stack
+ * survives, and the nested tool's depth check runs in `execute`, so args
+ * rejected there still reach this renderer verbatim — a recursive walk would
+ * turn them into a RangeError that takes the whole conversation render down.
+ *
+ * A malformed `children` (present but not an array of items) contributes nothing
+ * rather than invalidating the summary: the ancestors it hangs under are still
+ * countable, and a mid-stream args string routinely carries a partial tail.
+ * @param roots - the top-level nodes, in model order.
+ * @returns every node, parents before their own children.
+ */
+function flatten(roots: readonly PlanItemLike[]): PlanItemLike[] {
+  const out: PlanItemLike[] = []
+  // Children push in reverse so the leftmost pops first: display order decides
+  // which `in_progress` node names the summary.
+  const stack = [...roots].reverse()
+  for (let item = stack.pop(); item !== undefined; item = stack.pop()) {
+    out.push(item)
+    const children = item.children
+    if (Array.isArray(children) && children.every(isItem)) {
+      for (const child of [...children].reverse()) stack.push(child)
+    }
+  }
+  return out
+}
